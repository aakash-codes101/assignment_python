    {
      "cell_type": "markdown",
      "source": [
        "Calculate the sum of even and odd numbers till N"
      ],
      "metadata": {
        "id": "RruYbM6Hj6EO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "n = int(input(\"Enter N: \"))\n",
        "sum_even = 0\n",
        "sum_odd = 0\n",
        "for i in range(1,n+1):\n",
        "  if i % 2 == 0:\n",
        "    sum_even += i\n",
        "  else:\n",
        "    sum_odd += i\n",
        "print(\"Even Sum\", sum_even)\n",
        "print(\"Odd Sum\", sum_odd)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "k9-lPnBelJrc",
        "outputId": "fb5ac0ce-a36c-4701-f3fb-1965930a42d5"
      },
      "execution_count": 69,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Enter N: 20\n",
            "Even Sum 110\n",
            "Odd Sum 100\n"
          ]
        }
      ]
