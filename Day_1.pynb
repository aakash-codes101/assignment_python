        "print(words_list)\n",
        "print(\"#\".join(words_list))\n",
        "\n",
        "print(my_string.count('python'))\n",
        "print(my_string.find(\"hello\"))\n",
        "\n",
        "print(my_string.endswith('amazing. '))"
      ],
