    {
      "cell_type": "code",
      "source": [
        "# prime number\n",
        "num = int(input(\"Enter a number: \"))\n",
        "for i in range(2,num):\n",
        "  if num % i == 0:\n",
        "    print(\"Not a prime number\")\n",
        "    break\n",
        "else:\n",
        "    print(\"prime number\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
